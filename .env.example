# Linux user/group IDs that should own generated files
PUID=1000
PGID=1000

# Timezone
TZ=America/Montevideo

# Base paths on the host
# Keep MEDIA_ROOT as the single entry point; when you move to mergerfs,
# change only this value (for example from /media/... to /srv/media).
CONFIG_ROOT=/srv/media-stack/config
MEDIA_ROOT=/srv/media
DOWNLOADS_ROOT=/srv/media/downloads
BOOKS_INBOX_ROOT=/srv/media/books-inbox

# Tailscale
TS_HOSTNAME=media-server
TS_AUTHKEY=tskey-your-auth-key

# Beszel
BESZEL_PORT=8090
BESZEL_APP_URL=http://localhost:8090
BESZEL_AGENT_TOKEN=
BESZEL_AGENT_KEY=

# Jellyfin usage/fee tracker
JELLYFIN_USAGE_PORT=8092
JELLYFIN_USAGE_PASSWORD=change-this-dashboard-password
JELLYFIN_USAGE_MONTHLY_FEE=0
JELLYFIN_USAGE_CURRENCY=USD
JELLYFIN_USAGE_HISTORY_DAYS=90

# WhatsApp notifications and Seerr request workflow
WAHA_BIND_IP=0.0.0.0
WAHA_PORT=8584
WAHA_API_KEY=replace-with-long-random-token
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=replace-with-long-random-password
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=replace-with-long-random-password
WAHA_SESSION=default
WHATSEERR_PORT=3006

# Jellyfin backup/restore helpers
JELLYFIN_CONFIG_DIR=/home/francisco/jellyfin/config
JELLYFIN_BACKUP_DIR=./backups/jellyfin
JELLYFIN_BACKUP_KEEP_LAST=14
JELLYFIN_BACKUP_GIT_COMMIT=false

# Duplicati encryption key
# openssl rand -hex 32
DUPLICATI_ENCRYPTION_KEY=your-encryption-key
DUPLICATI_WEBSERVICE_PASSWORD=

# ntfy
NTFY_BASE_URL=https://ntfy.example.com
NTFY_UPSTREAM_BASE_URL=https://ntfy.sh
NTFY_UPSTREAM_ACCESS_TOKEN=
NTFY_LOG_LEVEL=info

# Caddy (reverse proxy + TLS)
ACME_EMAIL=you@your-domain.tld
JELLYFIN_DOMAIN=jellyfin.your-domain.tld
JELLYSEERR_DOMAIN=jellyseerr.your-domain.tld
SONARR_DOMAIN=sonarr.your-domain.tld
RADARR_DOMAIN=radarr.your-domain.tld
BAZARR_DOMAIN=bazarr.your-domain.tld
NTFY_DOMAIN=ntfy.your-domain.tld
SHELFMARK_DOMAIN=shelfmark.your-domain.tld

# CrowdSec
# Set an alphanumeric key used by the firewall bouncer.
CROWDSEC_BOUNCER_KEY=replace-with-long-random-key

# API KEYS
RADARR_API_KEY=
SONARR_API_KEY=

QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
QBITTORRENT_WEBUI_PORT=8080

# Mousehole / MyAnonamouse dynamic seedbox IP updater
MOUSEHOLE_AUTH_PASSWORD=replace-with-long-random-password

# ProtonVPN / Gluetun (required when routing qBittorrent through ProtonVPN)
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=openvpn
OPENVPN_USER=your-openvpn-username+pmp
OPENVPN_PASSWORD=your-openvpn-password
SERVER_COUNTRIES=Argentina,Brazil
VPN_PORT_FORWARDING=on
