# Linux user/group IDs that should own generated files
PUID=1000
PGID=1000

# Timezone
TZ=America/Montevideo

# Base paths on the host
# Keep MEDIA_ROOT as the single entry point; when you move to mergerfs,
# change only this value (for example from /media/... to /srv/media).
CONFIG_ROOT=/srv/media-stack/config
MEDIA_ROOT=/srv/media
DOWNLOADS_ROOT=/srv/media/downloads

# Tailscale
TS_HOSTNAME=media-server
TS_AUTHKEY=tskey-your-auth-key

# Jellyfin backup/restore helpers
JELLYFIN_CONFIG_DIR=/home/francisco/jellyfin/config
JELLYFIN_BACKUP_DIR=./backups/jellyfin
JELLYFIN_BACKUP_KEEP_LAST=14
JELLYFIN_BACKUP_GIT_COMMIT=false

# Duplicati encryption key
# openssl rand -hex 32
DUPLICATI_ENCRYPTION_KEY=your-encryption-key
DUPLICATI_WEBSERVICE_PASSWORD=